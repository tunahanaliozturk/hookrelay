<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.3" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>

    <!--
      The Aspire CLI bundle is fetched at build time. Requiring it would make a plain `dotnet build` of
      this repository depend on a network round trip, so the host uses the packaged dashboard and DCP
      instead. Install the Aspire CLI from https://get.aspire.dev for the newer tooling features.
    -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    <UserSecretsId>hookrelay-apphost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.Kafka" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../HookRelay.Api/HookRelay.Api.csproj" />
    <ProjectReference Include="../HookRelay.ChaosReceiver/HookRelay.ChaosReceiver.csproj" />
    <ProjectReference Include="../HookRelay.Relay/HookRelay.Relay.csproj" />
    <ProjectReference Include="../HookRelay.Worker/HookRelay.Worker.csproj" />
  </ItemGroup>

</Project>
